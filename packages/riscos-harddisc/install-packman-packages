#!/bin/sh
# install-packman-packages [ROOT]: installs the PackMan packages that come
# with RISC OS on Linux (from riscos-harddisc 1.0.0026-1: RDPServer; from
# 1.0.0032-1: Folio, which the postinst makes the PDF viewer), each
# in ROOT/usr/share/riscos/packman/PACKAGE as PackMan would install it: its
# files (Apps...), its Info (Control, Copyright, Files), its line for
# PackMan's Status and the apps it has the boot look at. Each is installed
# once, only when PackMan has no record of it, so a newer version from
# PackMan, or one the user removed, is left alone; PackMan upgrades and
# removes them as its own. riscos-harddisc's postinst runs it; an image
# builder runs it with ROOT, the image's root.
#
# A package without a status file (from 1.0.0027-1: NetSurf 3.11, from
# NetSurf's own release, which has no PackMan record) is installed once
# (ROOT/var/lib/riscos/packman/PACKAGE records that, so one the user
# deletes stays deleted), only when none of the apps it lists in lookat is
# there, and never replaces a file (so a newer Tinct or !Cache is kept);
# PackMan offers to replace it if NetSurf is installed with PackMan later.
#
# From 1.0.0039-1, RISC OS files are found under either name IXFS gives
# them: "Status" (as PackMan saves it, the type an extended attribute) or
# "Status,fff"; and a package with a status file isn't installed when its
# apps are already there (put there some other way: a copy from a zip, or
# PackMan with a Status this script didn't see), so files are never copied
# over another copy (that left each one twice, "!RunImage" and
# "!RunImage,ff8").
#
# Copyright (c) 2026 Andrew Youll. MIT licence (see LICENSE).
set -e
root=${1:-}
hd="$root/riscos/HardDisc4"
pk="$hd/!Boot/Resources/!Packages"
# a RISC OS file's name as it is on the disc: plain (as RISC OS saves a file
# it renames into place), else with its ",xxx" type (also for a new file)
ro () { if [ -e "$1" ]; then echo "$1"; else echo "$1,$2"; fi; }
st=$(ro "$pk/Status" fff)
dt=$(ro "$hd/!Boot/Choices/Boot/Desktop" fea)
# a package's components (its Control's Components), as paths in HardDisc4
components () {
  sed -n 's/^Components: *//p' "$1" | tr ',' '\n' | sed 's/(.*)//; s/^ *//; s/ *$//' | tr . /
}
for d in "$root"/usr/share/riscos/packman/*; do
  [ -d "$pk" ] || continue
  name=$(basename "$d")
  if [ -f "$d/status" ]; then
    if [ -f "$st" ] && cut -f1 "$st" | grep -x "$name" >/dev/null; then continue; fi
    there=no
    for c in $(components "$(ro "$d/Info/Control" fff)"); do
      [ -e "$hd/$c" ] && there=yes
    done
    [ "$there" = no ] || continue
    cpflags=-a
  else
    there=no
    [ -e "$root/var/lib/riscos/packman/$name" ] && continue
    if [ -f "$d/lookat" ]; then
      while read -r app; do
        if [ -n "$app" ] && [ -e "$hd/$(echo "$app" | tr . /)" ]; then there=yes; fi
      done < "$d/lookat"
    fi
    mkdir -p "$root/var/lib/riscos/packman"
    : > "$root/var/lib/riscos/packman/$name"
    [ "$there" = no ] || continue
    cpflags="-a --update=none"
  fi
  for top in "$d"/*; do
    case "$(basename "$top")" in Info|status|lookat) continue ;; esac
    cp $cpflags "$top" "$hd/"
    (cd "$d" && find "$(basename "$top")") | while read -r f; do chown -h 1000:1000 "$hd/$f"; done
  done
  if [ -f "$d/status" ]; then
    # (a fresh record: PackMan has none, so any old one is stale, and its
    # plain-named files would sit beside these)
    rm -rf "$pk/Info/$name"
    mkdir -p "$pk/Info/$name"
    cp -a "$d/Info/." "$pk/Info/$name/"
    chown -R 1000:1000 "$pk/Info/$name"
    # Status: tab-separated lines, the last without a newline (as PackMan writes it)
    if [ -s "$st" ] && [ -n "$(tail -c1 "$st")" ]; then printf '\n' >> "$st"; fi
    cat "$d/status" >> "$st"
    chown 1000:1000 "$st"
  fi
  # look at: Filer_Boot in the Desktop file's BootBoot section, as PackMan does
  if [ -f "$d/lookat" ] && [ -f "$dt" ]; then
    while read -r app; do
      [ -n "$app" ] || continue
      line="Filer_Boot IXFS:\$.riscos.HardDisc4.$app"
      grep -qxF "$line" "$dt" && continue
      if grep -q '^|Start RISCOS BootBoot' "$dt"; then
        awk -v l="$line" '
          /^\|Start RISCOS BootBoot/ { inb = 1 }
          inb && /^\|End/ { print l; inb = 0 }
          { print }
        ' "$dt" > "$dt.new" && mv "$dt.new" "$dt"
      else
        printf '\n%s\n%s\n%s\n' "|Start RISCOS BootBoot 0.01 Auto tasks" "$line" "|End" >> "$dt"
      fi
    done < "$d/lookat"
    chown 1000:1000 "$dt"
  fi
done
exit 0
