#!/bin/sh
# HardDisc4 belongs to RISC OS (the user riscos, uid 1000)
#
# Copyright (c) 2026 Andrew Youll. MIT licence (see LICENSE).
set -e
# a RISC OS file's name as it is on the disc (from 1.0.0039-1): plain, as
# RISC OS leaves a file it saved by renaming it into place (the type an
# extended attribute), else with its ",xxx" type (also for a new file)
ro () { if [ -e "$1" ]; then echo "$1"; else echo "$1,$2"; fi; }
if [ "$1" = configure ]; then
  dpkg-query -L riscos-harddisc | while read -r f; do
    case "$f" in /riscos/HardDisc4/*) [ -e "$f" ] && chown -h 1000:1000 "$f" ;; esac
  done
  # a second PackMan Status, and Folio's or RDPServer's files twice, left by
  # earlier versions where PackMan had saved its Status (see the script)
  /usr/lib/riscos/tidy-packman-names
  # ARMEABISupport in !System.400, where PackMan's package puts it, the
  # newest copy kept (from 1.0.0034-1; earlier ones used 310): see the script
  /usr/lib/riscos/place-armeabisupport
  # MbufManager at start-up (every RISC OS 5 ROM has it; ROL's from 5.31-7),
  # with MbufRes for its Messages: !Omni's LanManFS and Access need it
  tb=$(ro "/riscos/HardDisc4/!Boot/Choices/Boot/PreDesk/TestBed" feb)
  if [ -f "$tb" ] && ! grep -q "MbufManager" "$tb"; then
    printf '%s\n' \
      "| MbufManager (DCI4 network buffers): in every RISC OS 5 ROM, and in this" \
      "| one from 5.31-7; !Omni's LanManFS and Access need it" \
      "RMEnsure MbufManager 0 RMLoad <IXFS\$HardDisc4>.TestBed.Modules.MbufRes" \
      "RMEnsure MbufManager 0 RMLoad <IXFS\$HardDisc4>.TestBed.Modules.MManager" >> "$tb"
    chown 1000:1000 "$tb"
  fi
  # LinuxOverlay: VideoOverlay's GraphicsV calls on rol-fb's overlay plane
  if [ -f "$tb" ] && ! grep -q "LinuxOverlay" "$tb"; then
    printf '%s\n' \
      "| LinuxOverlay: video overlays for VideoOverlay (Reel), on rol-fb's overlay" \
      "| plane (the display hardware scales the video and changes it at the" \
      "| vertical blank)" \
      "RMEnsure LinuxOverlay 0 RMLoad <IXFS\$HardDisc4>.TestBed.Modules.LinuxOverlay" >> "$tb"
    chown 1000:1000 "$tb"
  fi
  # SCSILinux: FileCore discs as SCSI:: drives (SCSIFS, from RISC OS 5.31-10)
  if [ -f "$tb" ] && ! grep -q "SCSILinux" "$tb"; then
    printf '%s\n' \
      "| SCSILinux: FileCore discs (USB sticks and SD cards in RISC OS's own format)" \
      "| as SCSI:: drives, through Linux; needs RISC OS 5.31-10 (SCSIFS in the ROM)" \
      "RMEnsure SCSILinux 0 RMLoad <IXFS\$HardDisc4>.TestBed.Modules.SCSILinux" >> "$tb"
    chown 1000:1000 "$tb"
  fi
  # *IXRun through *LinuxUser, always (rol-cmd runs it as RISC OS's own
  # Linux user, through the shell: no password, and the path is searched).
  # An earlier line (1.0.0022-1: through *Linux; 1.0.0023-1: only when
  # protected) is replaced, with its comment.
  if [ -f "$tb" ] && grep -q 'Alias\$IXRun' "$tb"; then
    awk '
      /^\| \*IXRun/ { skip = 1; next }
      skip && /^\| / { next }
      /Alias\$IXRun/ { skip = 0; next }
      { skip = 0; print }
    ' "$tb" > "$tb.new" && mv "$tb.new" "$tb"
  fi
  if [ -f "$tb" ] && ! grep -q 'Alias\$IXRun' "$tb"; then
    printf '%s\n' \
      "| *IXRun goes through *LinuxUser: rol-cmd runs the command (through the" \
      "| shell, so the path is searched) as RISC OS's own Linux user, with no" \
      "| password, protected or not (IXSupport's own needs Linux programs and a" \
      "| terminal in RISC OS's view of the files, which protected RISC OS hasn't)" \
      "Set Alias\$IXRun LinuxUser %%*0" >> "$tb"
    chown 1000:1000 "$tb"
  fi
  # !DiscIcon (the drive icons: HardDisc4, USB discs, SD cards) starts from
  # its own file in the boot's Tasks (from 1.0.0028-1), not from a line in
  # Pinboard's save file: a pinboard that replaces that file (ROD's
  # Pinboard2) left the drives without their icons. The old line goes.
  tk="/riscos/HardDisc4/!Boot/Choices/Boot/Tasks"
  if [ -d "$tk" ]; then
    pb=$(ro "$tk/Pinboard" feb)
    if [ -f "$pb" ] && grep -q '!DiscIcon' "$pb"; then
      grep -v '!DiscIcon' "$pb" > "$pb.new" || true
      cat "$pb.new" > "$pb"; rm -f "$pb.new"
    fi
    # !DiscIcon (1.0.0030-1) puts IXFS:$ on the icon bar too, labelled
    # "IXFS:$": Pinboard's AddTinyDir labels it just "$" from RISC OS
    # 5.31-16 (IXFS's full names have a disc name), so that line goes
    # (also as a Pinboard save writes it now, IXFS::ROL.$)
    if [ -f "$pb" ] && grep -Eq 'AddTinyDir IXFS:(:ROL\.)?\$[[:space:]]*$' "$pb"; then
      grep -Ev 'AddTinyDir IXFS:(:ROL\.)?\$[[:space:]]*$' "$pb" > "$pb.new" || true
      cat "$pb.new" > "$pb"; rm -f "$pb.new"
    fi
    if [ ! -e "$tk/DiscIcon" ] && [ ! -e "$tk/DiscIcon,feb" ]; then
      printf '%s\n' \
        "| DiscIcon: HardDisc4, USB discs and SD cards as drive icons" \
        "X Filer_Run <IXFS\$HardDisc4>.!Boot.Resources.!DiscIcon" > "$tk/DiscIcon,feb"
      chown 1000:1000 "$tk/DiscIcon,feb"
    fi
  fi
  # PackMan packages that come with RISC OS on Linux (RDPServer), installed
  # as PackMan would, once (see the script)
  /usr/lib/riscos/install-packman-packages
  # Folio (from 1.0.0032-1) opens PDF files: a file in the boot's Tasks sets
  # PDF's run action to Folio's !Run. Put there once (the stamp), so
  # deleting it to choose another viewer is kept. From 1.0.0033-1 it's a
  # macro (resolved when a PDF is opened, so it doesn't matter whether the
  # boot has looked at Folio yet); 1.0.0032-1's file, if unchanged, is
  # replaced.
  fs=/var/lib/riscos/packman/FolioPDF
  ff=$(ro "$tk/FolioPDF" feb)
  folio_pdf_old () {
    printf '%s\n' \
      "| Folio opens PDF files (filetype &ADF) when they're double-clicked. Delete" \
      "| this file to choose another PDF viewer: it's put here once (riscos-harddisc)." \
      'If "<Folio$Dir>"<>"" Then Set Alias$@RunType_ADF /<Folio$Dir>.!Run %%*0' \
      'If "<File$Type_ADF>"="" Then Set File$Type_ADF PDF'
  }
  folio_pdf () {
    printf '%s\n' \
      "| Folio opens PDF files (filetype &ADF) when they're double-clicked. Delete" \
      "| this file to choose another PDF viewer: it's put here once (riscos-harddisc)." \
      "| A macro, so it doesn't matter whether the boot has seen Folio yet." \
      'SetMacro Alias$@RunType_ADF If "<Folio$Dir>"<>"" Then /<Folio$Dir>.!Run %%*0 Else Error 0 Folio, the PDF viewer, hasn'"'"'t been seen: open the directory it'"'"'s in' \
      'If "<File$Type_ADF>"="" Then Set File$Type_ADF PDF'
  }
  if [ -f "$ff" ] && folio_pdf_old | cmp -s - "$ff"; then
    folio_pdf > "$ff"
    chown 1000:1000 "$ff"
  fi
  if [ -d "$tk" ] && [ ! -e "$fs" ]; then
    if [ ! -e "$ff" ]; then
      folio_pdf > "$ff"
      chown 1000:1000 "$ff"
    fi
    mkdir -p /var/lib/riscos/packman
    : > "$fs"
  fi
  # LinuxCodec at start-up (with the other TestBed modules)
  tb=$(ro "/riscos/HardDisc4/!Boot/Choices/Boot/PreDesk/TestBed" feb)
  if [ -f "$tb" ] && ! grep -q "LinuxCodec" "$tb"; then
    printf '%s\n' \
      "| LinuxCodec: Linux's video decoders (VideoCore's H.264 on a Pi 3 or 4) for" \
      "| RISC OS programs; on machines without one, LinuxCodec_Open says so and" \
      "| programs decode in software" \
      "RMEnsure LinuxCodec 0 RMLoad <IXFS\$HardDisc4>.TestBed.Codec.LinuxCodec" >> "$tb"
    chown 1000:1000 "$tb"
  fi
  # the VideoCore stand-ins at start-up too (ReelHWAccel's H.264)
  if [ -f "$tb" ] && ! grep -q "LoadVC" "$tb"; then
    printf '%s\n' \
      "| VideoCore stand-ins (VCHIQ, BCMSupport, PCI over Linux's /dev/vchiq and" \
      "| /dev/vcio): ReelHWAccel's H.264 decoding and encoding for Reel, Matinee" \
      "| and FFmpeg on a Pi 3 or 4. Only where Linux has a VideoCore." \
      "IfThere IXFS:\$.dev.vchiq Then Obey <IXFS\$HardDisc4>.TestBed.Codec.LoadVC" >> "$tb"
    chown 1000:1000 "$tb"
  fi
fi
exit 0
