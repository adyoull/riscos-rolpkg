set -e
if [ "$1" = configure ]; then
  # The running kernel's modules, kept by the preinst: put back if this
  # upgrade removed them (the kernel running is still the old one until
  # the machine restarts, and for good if the new one doesn't reach the
  # boot partition). Kept copies of kernels no longer running go, with
  # any folder put back for them that no package owns.
  k=/var/lib/riscos/kept-modules
  r=$(uname -r)
  if [ -d "$k" ]; then
    for v in "$k"/*; do
      [ -d "$v" ] || continue
      n=$(basename "$v")
      case $n in *.tmp) rm -rf "$v"; continue ;; esac
      if [ "$n" = "$r" ]; then
        if [ ! -d "/usr/lib/modules/$n" ]; then
          cp -a "$v" "/usr/lib/modules/$n"
          echo "The running kernel's modules ($n) are kept until the machine restarts with the new one."
        fi
      else
        rm -rf "$v"
        if [ -d "/usr/lib/modules/$n" ] && ! dpkg-query -S "/usr/lib/modules/$n" >/dev/null 2>&1; then
          rm -rf "/usr/lib/modules/$n"
        fi
      fi
    done
  fi
  /usr/lib/riscos/install-boot-files /usr/lib/riscos/boot-pi
  # config.txt: "dtparam=audio=on" has to come before the first dtoverlay
  # line. After one, the firmware gives it to that overlay (vc4-kms-v3d
  # has an "audio" of its own, HDMI's), the Pi's own sound stays off and
  # Linux gets no headphone socket (images up to 1.0.0020 had it after).
  # The file is otherwise the user's: only that line moves, and the file
  # as it was is kept as config.txt.old.
  dev=$(/usr/lib/riscos/fat-partition)
  mnt=$(mktemp -d)
  mount -t vfat -o shortname=mixed "$dev" "$mnt"
  c=$mnt/config.txt
  if [ -f "$c" ] && awk '
      { sub(/\r$/, "") }
      /^dtoverlay=/ { seen = 1 }
      /^dtparam=audio=on[ \t]*$/ { if (seen) late = 1; else early = 1 }
      END { exit !(late && !early) }' "$c"; then
    awk '
      { line = $0; sub(/\r$/, "", line) }
      line ~ /^dtparam=audio=on[ \t]*$/ { next }
      line ~ /^dtoverlay=/ && !done { print "dtparam=audio=on"; done = 1 }
      { print }' "$c" > "$c.new"
    cp -f "$c" "$c.old"
    kept=1
    sync
    mv -f "$c.new" "$c"
    echo "config.txt: dtparam=audio=on moved before the overlays, for the headphone socket (the file as it was: config.txt.old)."
  fi
  # config.txt: the Compute Modules' own USB controller. The firmware
  # leaves it as a device ("gadget") port; on the IO boards the USB
  # sockets (and their hub) hang off it, so it has to be a host, or no
  # keyboard, mouse or USB drive is seen (Raspberry Pi OS's config.txt
  # has the same lines). Added once, at the end; the file as it was is
  # kept as config.txt.old. Someone who has set the port up themselves
  # (any otg_mode or dwc2 line) is left alone.
  if [ -f "$c" ] && ! tr -d '\r' < "$c" | grep -q -E '^[ \t]*(otg_mode=|dtoverlay=dwc2)'; then
    # (config.txt.old stays the file as it was before this update)
    [ -n "${kept:-}" ] || cp -f "$c" "$c.old"
    { tr -d '\r' < "$c" | sed -e '$a\'
      printf '%s\n' '' '# Compute Modules: the USB sockets on the IO board (host mode)' \
        '[cm4]' 'otg_mode=1' '[cm5]' 'dtoverlay=dwc2,dr_mode=host' '[all]'
    } > "$c.new"
    sync
    mv -f "$c.new" "$c"
    echo "config.txt: the Compute Modules' USB port set to host mode, for the IO board's USB sockets (the file as it was: config.txt.old)."
  fi
  sync
  umount "$mnt"
  rmdir "$mnt"
fi
exit 0
