set -e
if [ "$1" = configure ]; then
  # OpenSSL (apt's https) looks for the root certificates in /usr/lib/ssl,
  # which only Debian's openssl package makes
  mkdir -p /usr/lib/ssl
  [ -e /usr/lib/ssl/cert.pem ] || ln -s /etc/ssl/certs/ca-certificates.crt /usr/lib/ssl/cert.pem
  [ -e /usr/lib/ssl/certs ] || ln -s /etc/ssl/certs /usr/lib/ssl/certs
  # The firmware of Wi-Fi and network adapters is in Debian's own packages
  # (firmware-realtek and the rest), which the kernel packages depend on;
  # they are in Debian's "non-free-firmware" section, which the images
  # didn't have in their package sources. Added to Debian's entries (not
  # to anyone else's). apt has to read the lists again before it can see
  # those packages: /var/lib/riscos/apt-again tells rol-info, which
  # Updates runs when the install is over, to do that and install what
  # was left (the kernel and the firmware).
  changed=
  f=/etc/apt/sources.list.d/debian.sources
  if [ -f "$f" ] && grep '^Components:' "$f" | grep -qv non-free-firmware; then
    sed -i '/^Components:/{/non-free-firmware/!s/[ \t]*$/ non-free-firmware/}' "$f"
    changed=1
  fi
  f=/etc/apt/sources.list
  if [ -f "$f" ] && grep -E '^deb[ \t].*debian.* main' "$f" | grep -qv non-free-firmware; then
    sed -i -E '/^deb[ \t].*debian.* main/{/non-free-firmware/!s/[ \t]*$/ non-free-firmware/}' "$f"
    changed=1
  fi
  # Debian's firmware-misc-nonfree recommends three more packages, which apt
  # would install with it: the firmware of NVIDIA and Intel graphics chips
  # and Intel odds and ends (about 48 MB to download, 107 MB installed).
  # Nothing here uses them: the kernels have no driver for those chips. A
  # pin keeps apt from installing them (delete the file to have them).
  # systemd and the other inits never chosen by apt (CUPS's colour
  # management, colord, recommends a chain that ends in systemd-sysv:
  # riscos-support 1.0.0088-1's update went that way). Always written, as
  # ROL can't start without its own init.
  mkdir -p /etc/apt/preferences.d
  cat > /etc/apt/preferences.d/riscos-init <<'EOF'
Explanation: RISC OS on Linux starts with its own init (riscos-support):
Explanation: these would replace it, or need systemd running.
Package: systemd systemd-sysv sysvinit-core udev
Pin: release *
Pin-Priority: -1
EOF
  f=/etc/apt/preferences.d/riscos-firmware
  if [ ! -e "$f" ]; then
    mkdir -p /etc/apt/preferences.d
    cat > "$f" <<'EOF'
Explanation: RISC OS on Linux: firmware-misc-nonfree recommends these, and
Explanation: nothing here uses them (no driver for those chips in the
Explanation: kernels). Delete this file to let apt install them.
Package: firmware-nvidia-graphics firmware-intel-graphics firmware-intel-misc
Pin: release *
Pin-Priority: -1
EOF
  fi
  if [ -n "$changed" ]; then
    mkdir -p /var/lib/riscos
    : > /var/lib/riscos/apt-again
    echo "Debian's non-free-firmware section (the firmware of Wi-Fi and network adapters) added to the package sources."
  fi
  # RISC OS's settings (CMOS RAM) as they are at this update, kept beside
  # them as CMOS.bak (RISC OS: !Boot.Loader.CMOS/bak): copy it over CMOS
  # to have them back. !Boot.Loader is the FAT partition from 1.0.0064-1
  # (root's chown means nothing there).
  c='/riscos/HardDisc4/!Boot/Loader/CMOS'
  if [ -s "$c" ]; then
    if cp -f "$c" "$c.bak.new" 2>/dev/null && mv -f "$c.bak.new" "$c.bak" 2>/dev/null; then
      chown 1000:1000 "$c.bak" 2>/dev/null || true
    else
      rm -f "$c.bak.new" 2>/dev/null || true
    fi
  fi
  # Raspberry Pi 5, 500 and Compute Module 5: some NVMe drives stop
  # answering once they have gone into a power-saving state there (andym's
  # Argon ONE UP: left idle, the battery icon went and HardDisc4 gave
  # "Disc Error"; with these two settings it ran for hours). So NVMe
  # power-state changes and PCIe link power saving are turned off: added
  # once to the end of cmdline.txt's line on the FAT partition
  # (!Boot.Loader), the file as it was kept as cmdline.txt.old. Someone
  # who has set either themselves is left alone.
  if grep -q -a -E 'Raspberry Pi 5|Compute Module 5' /proc/device-tree/model 2>/dev/null; then
    dev=$(/usr/lib/riscos/fat-partition 2>/dev/null) || dev=
    mnt=$(mktemp -d)
    if [ -n "$dev" ] && mount -t vfat -o shortname=mixed "$dev" "$mnt" 2>/dev/null; then
      l=$mnt/cmdline.txt
      if [ -s "$l" ] && ! grep -q -E 'nvme_core\.default_ps_max_latency_us=|pcie_aspm=' "$l"; then
        if cp -f "$l" "$l.old" && awk '
            NR == 1 { sub(/\r$/, ""); sub(/[ \t]+$/, "")
                      print $0 " nvme_core.default_ps_max_latency_us=0 pcie_aspm=off"; next }
            { print }' "$l" > "$l.new"; then
          sync
          mv -f "$l.new" "$l"
          echo "cmdline.txt: NVMe and PCIe power saving turned off, for NVMe drives that stop answering when idle on a Pi 5 or CM5 (the file as it was: cmdline.txt.old)."
        else
          rm -f "$l.new"
        fi
      fi
      sync
      umount "$mnt" || true
    fi
    rmdir "$mnt" 2>/dev/null || true
  fi
  # PackMan, put back in HardDisc4.Apps.Admin when there's no !PackMan on
  # the disc at all (see the script; one moved elsewhere is left alone)
  /usr/lib/riscos/place-packman || true
  # The Windows Dev Kit 2023: only the GPU's two files of firmware-qcom-soc
  # (see the script; nothing on other machines)
  /usr/lib/riscos/qcom-gpu-firmware || true
  # ROL's init kept as the machine's init: copies of init-guard and of the
  # init outside the package, for apt's and dpkg's hooks (see the script)
  /usr/lib/riscos/init-guard setup || true
  echo "The Linux side of RISC OS on Linux is updated: restart (shut down and switch on) to use it."
fi
exit 0
