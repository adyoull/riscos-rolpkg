#!/bin/sh
# Prints the device of the FAT partition RISC OS on Linux starts from:
# partition 1 of the disc the root file system is on.
set -e
mm=$(mountpoint -d /)
disk=$(basename "$(readlink -f "/sys/dev/block/$mm/..")")
for p in /sys/block/"$disk"/"$disk"*; do
  [ -f "$p/partition" ] && [ "$(cat "$p/partition")" = 1 ] && { echo "/dev/$(basename "$p")"; exit 0; }
done
echo "fat-partition: no partition 1 on $disk" >&2
exit 1
